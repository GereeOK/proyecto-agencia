rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios — cada uno lee/edita el suyo; admin edita todos; admin/seller
    // pueden leer cualquier perfil (necesario para las pantallas de gestión
    // del lado web). El grupo familiar ("grupofamiliar") vive como array
    // dentro de este mismo doc — ya cubierto por el "allow write" de acá
    // arriba, no necesita regla propia (antes el móvil usaba una
    // subcolección "familia" separada, invisible para la web).
    match /users/{userId} {
      allow read:  if request.auth != null
                   && (request.auth.uid == userId || isAdmin() || isSeller());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /itinerary/{docId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Servicios (experiencias) — lectura pública; escritura solo seller/admin,
    // salvo "cupoActual": cualquier usuario autenticado puede descontarlo
    // (nunca subirlo) como parte de la transacción que crea una reserva
    // (saveReservaTransaccional en la web, crearReserva en el móvil).
    match /servicios/{id} {
      allow read:  if true;
      allow create, delete: if request.auth != null && (isSeller() || isAdmin());
      allow update: if request.auth != null && (
        isSeller() || isAdmin() ||
        (resource.data.diff(request.resource.data).affectedKeys().hasOnly(['cupoActual']) &&
         request.resource.data.cupoActual < resource.data.cupoActual &&
         request.resource.data.cupoActual >= 0)
      );
    }

    // Empresas — seller gestiona la suya, admin gestiona todas
    match /companies/{id} {
      allow read, write: if request.auth != null && (isSeller() || isAdmin());
    }

    // Reservas — turista ve/crea las suyas; admin y seller ven/editan todas.
    //
    // "userId" (UID de Firebase Auth) es el identificador canónico — tanto
    // la app móvil como la web lo escriben al crear una reserva. El fallback
    // por "email" en el read cubre únicamente las reservas viejas, creadas
    // desde la web ANTES de que empezara a mandar userId (ver backfillUserId.js).
    // Una vez corrido ese backfill en producción, se puede borrar el fallback.
    match /reservas/{reservaId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isAdmin() || isSeller()
      );
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        isAdmin() || isSeller() ||
        (resource.data.userId == request.auth.uid && resource.data.estado == 'pendiente')
      );
      allow delete: if false;

      // Mensajes de reserva — chat entre usuario y seller.
      // Campo unificado "autorId" (antes el móvil usaba "senderId"; los
      // mensajes viejos con ese campo siguen siendo legibles, solo no se
      // vuelven a escribir con ese nombre).
      match /mensajes/{msgId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/reservas/$(reservaId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/reservas/$(reservaId)).data.email == request.auth.token.email ||
          isAdmin() || isSeller()
        );
        allow create: if request.auth != null
                      && request.resource.data.autorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Favoritos — unificado: ambos clientes usan la misma subcolección
    // "favoritos/{userId}/items/{servicioId}".
    match /favoritos/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reseñas — unificado: ambos clientes usan "resenas" (tipo:
    // "experiencia" | "empresa" | "plataforma"). El móvil solo crea tipo
    // "experiencia"; "reviews" queda deprecada (ver migración en
    // scripts/backfillUserId.js).
    match /resenas/{id} {
      allow read:   if true;
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Mensajes de contacto (formulario de la landing web) — cualquiera
    // crea, solo admin lee
    match /messages/{id} {
      allow create: if true;
      allow read:   if isAdmin();
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSeller() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }
  }
}
